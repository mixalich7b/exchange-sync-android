@startuml
title Композиция приложения и внешние системы
top to bottom direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultTextAlignment center

component "ExchangeSyncApplication\n:app" as Application #E8F3FF
component "AppContainer\nручная композиция" as Container #E8F3FF
component "Settings UI / ViewModel\n:feature:settings" as Ui #EEF9E8
component "Connection и Sync\nuse cases + ports\n:core" as Core #FFF6DA
package ":infrastructure" #F5ECFF {
  component "ActiveSync runtime\nverifier + remote calendar" as Network
  component "DataStore repositories" as Storage
  component "Owned calendar adapter" as Calendar
  component "Scheduler + WorkerFactory\npermissions + notifications\ndiagnostics" as AndroidAdapters
}
cloud "Exchange\nHTTPS / mTLS" as Exchange
database "Preferences DataStore" as DataStore
database "Calendar Provider" as Provider
node "Android\nKeyChain, WorkManager,\npermissions, notifications, Logcat" as Android

Application --> Container : создаёт на процесс
Container --> Ui : создаёт ViewModel
Ui --> Core : вызывает
Container ..> Network : связывает
Container ..> Storage
Container ..> Calendar
Container ..> AndroidAdapters
Core --> Network : через ports
Core --> Storage
Core --> Calendar
Core --> AndroidAdapters
Network --> Exchange
Network --> Android : KeyChain
Storage --> DataStore
Calendar --> Provider
AndroidAdapters --> Android

legend bottom
Сплошная стрелка — взаимодействие во время выполнения.
Пунктирная стрелка — ручная композиция адаптера.
Зависимости Gradle показаны на отдельной схеме.
endlegend
@enduml
