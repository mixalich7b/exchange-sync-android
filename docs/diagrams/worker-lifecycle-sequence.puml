@startuml
title Запуск и продолжение фоновой работы
skinparam shadowing false
skinparam backgroundColor white
skinparam sequenceMessageAlign center
hide footbox
autonumber
actor Trigger
control "Core lifecycle\n/ trigger" as Core
database SyncState
queue "Scheduler /\nWorkManager" as Work
control "Execution worker\n/ slice" as Worker
participant "Remote /\nowned calendar" as Adapters

Trigger -> Core : Save / Enable /\nSync Now / periodic
Core -> SyncState : transition + eligibility
alt запуск разрешён
  SyncState --> Core : QUEUED + fence
  Core -> Work : unique execution
  Work --> Core : durable enqueue
else run активен / trigger недопустим
  SyncState --> Core : Coalesced / Ignored
end
note over Core, Work
Новый профиль / Enable: сначала owned cleanup,
затем immediate и одна periodic work (15 минут).
end note
Work -> Worker : doWork(fence)
Worker -> SyncState : проверить fence
alt fence устарел
  Worker --> Work : success (Obsolete)
else fence актуален
  loop pages, пока есть изменения и не достигнут лимит
    Worker -> Adapters : fetchPage + applyPage
    Adapters --> Worker : outcome
    Worker -> SyncState : commit только\nпосле полного apply
    Worker -> Worker : после успешной page:\n10 страниц / 4 минуты?
  end
  alt terminal page, нет follow-up
    Worker -> SyncState : IDLE + last success
    Worker --> Work : success
  else continuation / recoverable reset / capacity
    Worker -> SyncState : QUEUED
    Worker -> Work : continuation, тот же fence
    Worker --> Work : success
  else transient, budget не исчерпан
    Worker -> SyncState : QUEUED + attempts
    Worker --> Work : retry, backoff от 30 секунд
  else persistent / пятая transient failure
    Worker -> SyncState : BLOCKED + safe problem
    Worker --> Work : success
  end
end
@enduml
