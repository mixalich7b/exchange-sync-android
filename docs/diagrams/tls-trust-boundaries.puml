@startuml
title Клиентская identity и доверие серверу
top to bottom direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultTextAlignment center

rectangle "Android security boundary" #F2F2F2 {
  component "KeyChain\nзакрытый ключ + client chain" as KeyChain #FFD1D1
  database "System trust store\nсистемные CA" as SystemStore #E8F3FF
}
rectangle "Процесс Exchange Sync" #FAFAFA {
  artifact "assets/tls/\nлокальные public CA\nPEM / DER, untracked" as Assets #E8F3FF
  component "System\nX509TrustManager" as SystemTrust
  component "Local\nX509TrustManager\nопциональный" as LocalTrust
  component "FixedAliasKeyManager\nодна client identity" as KeyManager
  component "CompositeX509TrustManager\nsystem-first; успех любого\nпринимает server chain" as Trust
  component "SSLContext + OkHttp\nобычная hostname verification\nautomatic redirects отключены" as Transport

  Assets --> LocalTrust : CertificateAssetLoader
  SystemTrust --> Trust
  LocalTrust --> Trust
  KeyManager --> Transport : client identity
  Trust --> Transport : server trust
}
cloud "Exchange\nHTTPS:443 / ActiveSync" as Exchange

KeyChain --> KeyManager : resolver: key handle\nи client X.509 chain
SystemStore --> SystemTrust
Transport <--> Exchange : TLS + HTTP

legend bottom
Закрытый ключ остаётся у Android; приложение хранит только alias.
Локальные CA не добавляются в системное хранилище.
Нет trust-all, собственного hostname verifier или pinning.
endlegend
@enduml
